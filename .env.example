# Mapbox Configuration (Optional)
# The app works without this — OpenStreetMap tiles and OSRM routing are used by default.
# Get a free token from: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# After creating this file, uncomment "# - .env" under flutter: assets: in pubspec.yaml
# Or pass at build time: flutter run --dart-define=MAPBOX_ACCESS_TOKEN=pk...

# Example:
# MAPBOX_ACCESS_TOKEN=pk.ey...
